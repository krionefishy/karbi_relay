# Общий с основным сервером секрет подписи JWT (одно и то же значение на обеих машинах)
CHANNEL_JWT_SECRET=replace-with-at-least-32-random-characters
# Аудитории разные: токен для похода на релей не должен работать в обратную сторону
CHANNEL_INBOUND_AUDIENCE=relay
CHANNEL_OUTBOUND_AUDIENCE=main

# Шифрование токенов ботов. Ключ живёт только здесь, основной сервер его не знает.
# Первый ключ используется для записи, остальные — для чтения при ротации.
CREDENTIALS_ENCRYPTION_KEYS=replace-with-a-fernet-key
CREDENTIALS_FINGERPRINT_KEY=replace-with-at-least-32-random-characters

# Сколько дней держать апдейты, за которыми основной сервер ещё не пришёл
INBOUND_RETENTION_DAYS=7

# Порт, на котором контейнер слушает loopback, за хостовым nginx
RELAY_PORT=8081

# Хостовой nginx. Адрес основного сервера — единственный, кому открыт вход;
# конфиг рендерится из этих значений скриптом deploy/render-nginx.sh.
MAIN_SERVER_IP=203.0.113.10
RELAY_SERVER_NAME=relay.internal
RELAY_TLS_PORT=8443
