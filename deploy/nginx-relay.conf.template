# Шаблон хостового nginx на VPS: терминирует TLS и режет по IP.
#
# Конкретные адреса сюда не попадают: файл рендерится на сервере скриптом
# deploy/render-nginx.sh из .env, а в репозитории остаются только имена
# переменных. Готовый конфиг лежит только на машине.
# Контейнер слушает только 127.0.0.1 — публиковать его наружу нельзя,
# docker пишет правила в iptables мимо ufw.

server {
    listen ${RELAY_TLS_PORT} ssl;
    listen [::]:${RELAY_TLS_PORT} ssl;
    server_name ${RELAY_SERVER_NAME};

    ssl_certificate     /etc/relay/tls/relay.crt;
    ssl_certificate_key /etc/relay/tls/relay.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    # Второй рубеж после ufw: сюда ходит ровно один адрес.
    allow ${MAIN_SERVER_IP};
    deny all;

    # Тела запросов не логируются нигде: в них токены ботов и тексты сообщений.
    access_log /var/log/nginx/relay.access.log;
    error_log /var/log/nginx/relay.error.log warn;

    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:${RELAY_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 5s;
        # sendMessage ждёт Telegram до 40 секунд, ответ должен успеть дойти.
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
